<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'cmu-survivor-setup-title'}"
                      MinSize="460 420">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="PhaseLabel" StyleClasses="LabelHeading" />
        <Label Name="TimerLabel" />
        <BoxContainer Name="VotePanel" Orientation="Vertical" SeparationOverride="4" />
        <BoxContainer Name="PickPanel" Orientation="Vertical" SeparationOverride="4" Visible="False">
            <Label Text="{Loc 'cmu-survivor-setup-roles'}" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False" MinHeight="180">
                <BoxContainer Name="Slots" Orientation="Vertical" SeparationOverride="2" />
            </ScrollContainer>
            <Label Text="{Loc 'cmu-survivor-setup-character'}" />
            <OptionButton Name="CharacterSelect" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>